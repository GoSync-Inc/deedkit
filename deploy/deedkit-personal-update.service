[Unit]
Description=Update a personal DeedKit install (deploy/personal-update.sh)
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/deedkit
ExecStart=/opt/deedkit/deploy/personal-update.sh
TimeoutStartSec=2h
