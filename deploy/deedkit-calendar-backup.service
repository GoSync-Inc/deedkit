[Unit]
Description=DeedKit family calendar encrypted backup and delivery (ANYM-607)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Admission: no start after 16:02 UTC (a Persistent= catch-up after a reboot, a late manual start): from then on
# TimeoutStartSec and the two stop budgets could reach messaging's 18:00 run. A skipped start waits for the next
# day's timer; a failed read skips too (fail closed).
ExecCondition=/bin/sh -c 'm=$$(date -u +%%H%%M) || exit 1; case "$$m" in [0-2][0-9][0-5][0-9]) ;; *) exit 1;; esac; [ "$$m" -le 1602 ]'
ExecStart=/usr/bin/python3 -I /opt/personal-os-probe/ops/backup_runner.py --config /opt/deedkit/calendar-backup/runner.json
# Recovery after every run that started; a start the condition skipped ran nothing, so it recovers nothing (systemd
# still runs ExecStopPost then, with SERVICE_RESULT=exec-condition). A journal left by an earlier failed recovery
# waits for the next admitted run, and its .unsettled marker keeps deploys out meanwhile.
ExecStopPost=/bin/sh -c '[ "$$SERVICE_RESULT" = exec-condition ] || exec /usr/bin/python3 -I /opt/personal-os-probe/ops/backup_runner.py --config /opt/deedkit/calendar-backup/runner.json --recover-stop'
# Exclusion is the runner's: it waits at most 5400 s for messaging's runner lock (its host_lock), which a deploy and
# messaging's 18:00 run hold. A run admitted by 16:02:59 ends, lock wait included, by TimeoutStartSec; the stop of
# its main process and its ExecStopPost each get their own TimeoutStopSec, and all of it ends before 18:00, so the
# calendar never holds that lock into messaging's run. No Restart=: a retry could; a failed day stays in
# status.json until the next day's timer.
TimeoutStartSec=6300s
TimeoutStopSec=180s
User=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=192M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# Its own job directory; messaging's backup directory only for the shared lock and its .unsettled marker.
ReadWritePaths=/opt/deedkit/calendar-backup/backups /opt/personal-os-probe/backups
