# ~/.config/deedkit/feedback-bridge.env, mode 0600 (the bridge refuses a looser file). Names only: no value here is real.
DEEDKIT_GATEWAY_URL=https://gateway.example.invalid
DEEDKIT_FEEDBACK_KEY_FILE=/home/USER/.config/deedkit/feedback-key
# Optional:
# DEEDKIT_FEEDBACK_SUBSCRIPTION_ID=
# DEEDKIT_BRIDGE_TRACKER=DK
# DEEDKIT_BRIDGE_BACKFILL_DAYS=14
# DEEDKIT_BRIDGE_STATE_DIR=/home/USER/.local/state/deedkit-feedback-bridge
