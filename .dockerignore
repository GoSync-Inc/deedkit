# Include only the shared runtime module; the exclusions below still apply.
packages/*
!packages/platform-contracts/
packages/platform-contracts/*
!packages/platform-contracts/src/
packages/platform-contracts/src/*
!packages/platform-contracts/src/platform_contracts/
packages/platform-contracts/src/platform_contracts/*
!packages/platform-contracts/src/platform_contracts/__init__.py
!packages/platform-contracts/src/platform_contracts/release.py

.venv
__pycache__
.pytest_cache
*.log
.DS_Store
**/.DS_Store
._*
**/._*
**/node_modules
# Runtime/private data. Keep public examples named *.example.*.
**/.env
**/.env.*
!**/.env.example
private/
sessions/
spool/
data/
backups/
outputs/
archives/
.local/
*.session
*.session-*
*.dsn
*.token
*.key
*.pem
*.agekey
*.age
*.dump
*.sqlite
*.sqlite3
node_modules/
.venv/
__pycache__/
.pytest_cache/
.git
.git/**
.github/*
!.github/workflows
.github/workflows/*
!.github/workflows/*.yml
!.github/workflows/*.yaml
deploy/private/
**/.venv
**/__pycache__
**/.pytest_cache
*.credentials.json
*.permit.json
**/.wwebjs_auth
**/.wwebjs_cache
*.har

dist/
