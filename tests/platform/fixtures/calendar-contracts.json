              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          },
          "duration": {
            "anyOf": [
              {
                "maximum": 1440,
                "minimum": 5,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Duration"
          },
          "calendar": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calendar"
          },
          "event": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/EventQuery"
              },
              {
                "type": "null"
              }
