                    "action": {
                      "const": "unproject"
                    }
                  },
                  "required": [
                    "action"
                  ]
                },
                "then": {
                  "oneOf": [
                    {
                      "properties": {
                        "operation_id": {
                          "type": "string"
                        },
                        "calendar_ref": {
                          "type": "null"
                        },
                        "event_ref": {
                          "type": "null"
                        }
                      },
                      "required": [
                        "operation_id"
                      ]
                    },
                    {
                      "properties": {
                        "calendar_ref": {
                          "type": "string"
                        },
                        "event_ref": {
                          "type": "string"
                        },
                        "operation_id": {
                          "type": "null"
                        }
                      },
                      "required": [
