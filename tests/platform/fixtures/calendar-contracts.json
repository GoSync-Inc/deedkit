                      ]
                    }
                  ],
                  "properties": {
                    "event": {
                      "type": "null"
                    },
                    "activity": {
                      "type": "null"
                    }
                  }
                }
              }
            ],
            "properties": {
              "action": {
                "enum": [
                  "create",
