+type noFrameRetryKey struct{}
+
+// WithoutFrameRetry returns a context under which a request interrupted by a
+// websocket disconnection is never written again after reconnecting: the
+// caller gets a DisconnectedError instead. Use it for requests that must not
+// be applied twice, such as message sends and state changes, where the frame
+// may already have reached the server before the disconnection.
+func WithoutFrameRetry(ctx context.Context) context.Context {
+	return context.WithValue(ctx, noFrameRetryKey{}, true)
+}
+
+// FrameRetryDisabled reports whether ctx was derived from WithoutFrameRetry.
+func FrameRetryDisabled(ctx context.Context) bool {
+	disabled, _ := ctx.Value(noFrameRetryKey{}).(bool)
+	return disabled
+}
