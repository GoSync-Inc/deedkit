+// cancelResponse unregisters a waiter without closing it: receiveResponse may
+// already have taken the waiter out of the map and be sending to it outside the
+// lock, and a send on a closed channel panics. The channel is buffered, so that
+// send never blocks; an abandoned channel is garbage collected.
 func (cli *Client) cancelResponse(reqID string, ch chan *waBinary.Node) {
 	cli.responseWaitersLock.Lock()
-	close(ch)
-	delete(cli.responseWaiters, reqID)
+	if current, ok := cli.responseWaiters[reqID]; ok && current == ch {
+		delete(cli.responseWaiters, reqID)
+	}
 	cli.responseWaitersLock.Unlock()
 }
 
